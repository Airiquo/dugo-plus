{
  "name": "dugo-plus",
  "private": true,
  "type": "module",
  "description": "Root tooling for Dugo+: Firestore rules tests, the reference-data seed script, and the users-shape backfill.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-dugo \"node firestore.rules.test.mjs\"",
    "test:matching": "node --test web/src/utils/geohash.test.js web/src/utils/matching.test.js web/src/utils/eligibility.test.js worker/src/firestore.test.js worker/src/matcher.test.js worker/src/audit.test.js",
    "check:docs": "node tools/check-docs.mjs",
    "seed": "node scripts/seed-reference-data.mjs",
    "create:hospital": "node scripts/create-hospital.mjs",
    "set:claims": "node scripts/set-claims.mjs",
    "backfill:users": "node scripts/backfill-users-shape.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.toml --local",
    "worker:check": "wrangler deploy -c worker/wrangler.toml --dry-run --outdir .wrangler/tmp",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "wrangler": "^4.0.0"
  }
}

# Firebase web config for the Dugo+ app.
#
# Copy this file to web/.env.local and fill in the values from your project:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup.
#
# These values are not secrets — a Firebase web API key is a public project
# identifier and Firebase enforces access with its own rules — but .env.local is
# gitignored so no single project is baked into the repo.
#
# With any of these missing or empty the app does not start: every route
# renders the NotConfigured screen (web/src/pages/shared/NotConfigured.jsx),
# which names the missing values. See README, "Authentication".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Formspree endpoint for the partnership intake form (D21, /partner). Public
# form endpoint, not a secret. With this empty the partner page still renders
# but its submit reports the mailbox fallback instead of posting.
VITE_FORMSPREE_ENDPOINT=

# Cloudflare Worker URL for immediate matching (F7), for example
# https://dugo-matching.<account>.workers.dev. With this empty, request creation
# still succeeds and the Worker cron fallback matches the request within a minute.
VITE_MATCHING_ENDPOINT=

# Free account service (D33/D38). Shipped path is the Cloudflare Worker's
# /accounts route, e.g. https://dugo-matching.<account>.workers.dev/accounts;
# a Node host (workers/account-service) works too, e.g. .../api/account. Hosts
# the privileged account operations (FR-040) when Cloud Functions cannot be
# deployed (no Blaze plan). Public URL, not a secret. With this empty the app
# creates hospital accounts in the browser (D34). See workers/account-service/README.md.
VITE_ACCOUNT_SERVICE_URL=

# Optional profile pictures. Public values for a restricted unsigned Cloudinary
# preset; never put an API secret in a VITE_* variable. See docs/PROFILE_PICTURES.md.
# Empty values disable uploading without blocking other profile edits or removal.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional override for the donor response/read service (local development).
# Otherwise the app uses VITE_MATCHING_ENDPOINT + /donor/respond.
VITE_DONOR_RESPONSE_ENDPOINT=

# Firebase web config for the Dugo+ app.
#
# Copy this file to web/.env.local and fill in the values from your project:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup.
#
# These values are not secrets — a Firebase web API key is a public project
# identifier and Firebase enforces access with its own rules — but .env.local is
# gitignored so no single project is baked into the repo.
#
# With any of these missing or empty the app does not start: every route
# renders the NotConfigured screen (web/src/pages/shared/NotConfigured.jsx),
# which names the missing values. See README, "Authentication".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Formspree endpoint for the partnership intake form (D21, /partner). Public
# form endpoint, not a secret. With this empty the partner page still renders
# but its submit reports the mailbox fallback instead of posting.
VITE_FORMSPREE_ENDPOINT=
